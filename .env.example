# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=123456789:replace_this_with_your_real_token
# Optional: comma-separated numeric Telegram user IDs, e.g. 123456789,987654321
ADMIN_IDS=
# Restaurant display name
RESTAURANT_NAME=Restaurant
# Local SQLite database path
DATABASE_PATH=restaurant.db
# Currency label shown to customers. Existing catalog prices are in somoni.
CURRENCY=сомони
